<% content_for :title, "Update your password" %>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :password, "New password", class: "label" %>
    <%= render "shared/password_field", form: form, field: :password, autofocus: true, autocomplete: "new-password",
          minlength: User::PASSWORD_MIN_LENGTH, aria: { describedby: "password-hint" } %>
    <p id="password-hint" class="mt-2 text-xs text-gray-500">At least <%= User::PASSWORD_MIN_LENGTH %> characters.</p>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm new password", class: "label" %>
    <%= render "shared/password_field", form: form, field: :password_confirmation, autocomplete: "new-password" %>
  </div>

  <%= form.submit "Save", class: "btn-primary w-full" %>
<% end %>
