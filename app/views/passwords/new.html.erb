<% content_for :title, "Forgot your password?" %>

<%= form_with url: passwords_path, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :email_address, class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], class: "input mt-2" %>
  </div>

  <%= form.submit "Email reset instructions", class: "btn-primary w-full" %>
<% end %>

<p class="mt-10 text-center text-sm text-gray-500">
  Remembered it? <%= link_to "Sign in", new_session_path, class: "link" %>
</p>
