<% content_for :title, @client.name %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <%= link_to "← Clients", clients_path, class: "link text-sm" %>
    <h1 class="mt-2 text-2xl font-semibold text-gray-900"><%= @client.name %></h1>
  </div>

  <div class="flex gap-3">
    <%= link_to "Edit", edit_client_path(@client), class: "btn-secondary" %>
    <%= button_to "Delete", @client, method: :delete, class: "btn-danger",
          form: { data: { turbo_confirm: "Delete #{@client.name}? This cannot be undone." } } %>
  </div>
</div>

<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-base font-semibold text-gray-900">Details</h2>
    <dl class="mt-4 space-y-3 text-sm">
      <div>
        <dt class="text-gray-500">Email</dt>
        <dd class="text-gray-900"><%= @client.email ? mail_to(@client.email, class: "link") : "—" %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Phone</dt>
        <dd class="text-gray-900"><%= @client.phone || "—" %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Website</dt>
        <dd class="text-gray-900">
          <%= @client.website ? link_to(@client.website, @client.website, class: "link", target: "_blank", rel: "noopener noreferrer") : "—" %>
        </dd>
      </div>
    </dl>
  </section>

  <section class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-base font-semibold text-gray-900">Address</h2>
    <address class="mt-4 text-sm not-italic text-gray-900">
      <%= safe_join(@client.address_lines, tag.br) %>
    </address>
  </section>

  <section class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-base font-semibold text-gray-900">Contact person</h2>
    <dl class="mt-4 space-y-3 text-sm">
      <div>
        <dt class="text-gray-500">Name</dt>
        <dd class="text-gray-900"><%= @client.contact_name || "—" %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Email</dt>
        <dd class="text-gray-900"><%= @client.contact_email ? mail_to(@client.contact_email, class: "link") : "—" %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Phone</dt>
        <dd class="text-gray-900"><%= @client.contact_phone || "—" %></dd>
      </div>
    </dl>
  </section>
</div>

<% if @client.notes %>
  <section class="mt-6 rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-base font-semibold text-gray-900">Notes</h2>
    <p class="mt-4 whitespace-pre-line text-sm text-gray-900"><%= @client.notes %></p>
  </section>
<% end %>
