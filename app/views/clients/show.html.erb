<% content_for :title, @client.name %>

<%= link_to "← Clients", @client.archived? ? clients_path(show: "archived") : clients_path, class: "link text-sm" %>

<div class="mt-4 flex flex-wrap items-start justify-between gap-4">
  <div class="flex items-center gap-4">
    <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-brand-100 text-lg font-semibold text-brand-700" aria-hidden="true">
      <%= @client.initials %>
    </span>
    <div class="min-w-0">
      <h1 class="flex flex-wrap items-center gap-3 text-2xl font-semibold text-gray-900">
        <%= @client.name %>
        <% if @client.archived? %>
          <span class="rounded-md bg-gray-100 px-2 py-1 font-sans text-xs font-medium text-gray-600">Archived</span>
        <% end %>
      </h1>
      <ul role="list" class="mt-1 flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-500">
        <li class="flex items-center gap-1.5"><%= heroicon(:map_pin, class: "size-4") %><%= @client.city %>, <%= @client.country_name %></li>
        <% if @client.email %>
          <li class="flex items-center gap-1.5"><%= heroicon(:envelope, class: "size-4") %><%= mail_to @client.email, class: "hover:text-brand-600" %></li>
        <% end %>
        <% if @client.phone %>
          <li class="flex items-center gap-1.5"><%= heroicon(:phone, class: "size-4") %><%= phone_to @client.phone, class: "hover:text-brand-600" %></li>
        <% end %>
        <% if @client.website %>
          <li class="flex items-center gap-1.5">
            <%= heroicon(:globe, class: "size-4") %><%= link_to @client.website_host, @client.website, target: "_blank", rel: "noopener noreferrer", class: "hover:text-brand-600" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <% if @client.archived? %>
      <%= button_to "Unarchive", client_archive_path(@client), method: :delete, class: "btn-primary" %>
    <% else %>
      <%= link_to "New invoice", new_invoice_path(client_id: @client.id), class: "btn-primary" %>
      <%= link_to "Edit", edit_client_path(@client), class: "btn-secondary" %>
      <%= button_to "Archive", client_archive_path(@client), class: "btn-secondary",
            form: { data: { turbo_confirm: "#{@client.name} will be hidden from your clients and can't get new invoices until you unarchive it. " \
              "Existing invoices aren't affected.", confirm_title: "Archive client", confirm_button: "Archive" } } %>
    <% end %>
    <% if @pagy.count.zero? %>
      <%= button_to "Delete", @client, method: :delete, class: "btn-danger",
            form: { data: { turbo_confirm: "Delete #{@client.name}? This cannot be undone.", confirm_title: "Delete client",
              confirm_button: "Delete", confirm_destructive: true } } %>
    <% end %>
  </div>
</div>

<div class="@container mt-8">
  <dl class="grid grid-cols-1 gap-5 @xl:grid-cols-2 @5xl:grid-cols-4">
    <% [ [ "Billed", :banknotes, "bg-brand-50 text-brand-600", @summary.billed, "#{pluralize(@summary.billed.count, "invoice")} issued", "Nothing billed yet" ],
         [ "Paid", :check_circle, "bg-green-50 text-green-600", @summary.paid, "#{@summary.paid.count} paid", "No payments yet" ],
         [ "Outstanding", :clock, "bg-amber-50 text-amber-600", @summary.outstanding, "#{@summary.outstanding.count} awaiting payment", "Nothing owed" ],
         [ "Overdue", :warning, "bg-red-50 text-red-600", @summary.overdue, "#{@summary.overdue.count} past due", "Nothing overdue" ] ].each do |label, icon, tone, totals, caption, empty| %>
      <%= render "shared/stat_card", label:, icon:, tone:, amounts: totals.amounts, caption:, empty: %>
    <% end %>
  </dl>
</div>

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section aria-labelledby="client-invoices-heading" class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-900/5 lg:col-span-2">
    <div class="flex items-center justify-between gap-4 px-6 pt-5">
      <h2 id="client-invoices-heading" class="text-base font-semibold text-gray-900">Invoices <span class="font-normal text-gray-500">· <%= @pagy.count %></span></h2>
    </div>

    <% if @invoices.any? %>
      <div class="mt-3 overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-100 text-sm">
          <thead class="text-left text-xs font-medium tracking-wide text-gray-500 uppercase">
            <tr>
              <th scope="col" class="px-6 py-2">Number</th>
              <th scope="col" class="px-3 py-2">Issued</th>
              <th scope="col" class="px-3 py-2">Due</th>
              <th scope="col" class="px-3 py-2">Status</th>
              <th scope="col" class="px-6 py-2 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-gray-600">
            <% @invoices.each do |invoice| %>
              <tr class="relative hover:bg-gray-50">
                <td class="px-6 py-3 font-medium whitespace-nowrap">
                  <%= link_to invoice.number || "Draft", invoice,
                        class: [ "after:absolute after:inset-0", invoice.number ? "text-gray-900" : "font-normal text-gray-400" ] %>
                </td>
                <td class="px-3 py-3 whitespace-nowrap"><%= l(invoice.issue_date, format: :medium) %></td>
                <td class="px-3 py-3 whitespace-nowrap"><%= invoice.due_date ? l(invoice.due_date, format: :medium) : "—" %></td>
                <td class="px-3 py-3 whitespace-nowrap">
                  <%= invoice_status_badge(invoice) %>
                  <% if invoice.archived? %>
                    <span class="ml-1 rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">Archived</span>
                  <% end %>
                </td>
                <td class="px-6 py-3 text-right font-medium whitespace-nowrap tabular-nums text-gray-900"><%= format_money(invoice.total, invoice.currency) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.last > 1 %>
        <div class="flex justify-center border-t border-gray-100 py-4"><%== @pagy.series_nav %></div>
      <% end %>
    <% else %>
      <div class="px-6 pt-3 pb-6">
        <p class="text-sm text-gray-500">No invoices yet for this client.</p>
        <% unless @client.archived? %>
          <%= link_to "Create the first one", new_invoice_path(client_id: @client.id), class: "link mt-2 inline-block text-sm" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <div class="space-y-6">
    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
      <h2 class="text-base font-semibold text-gray-900">Address</h2>
      <p class="mt-3 text-sm text-gray-700"><%= safe_join(@client.address_lines, tag.br) %></p>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
      <h2 class="text-base font-semibold text-gray-900">Contact person</h2>
      <% if @client.contact_name || @client.contact_email || @client.contact_phone %>
        <dl class="mt-3 space-y-2 text-sm text-gray-700">
          <% if @client.contact_name %>
            <div><dt class="sr-only">Name</dt><dd class="font-medium text-gray-900"><%= @client.contact_name %></dd></div>
          <% end %>
          <% if @client.contact_email %>
            <div><dt class="sr-only">Email</dt><dd><%= mail_to @client.contact_email, class: "link font-normal" %></dd></div>
          <% end %>
          <% if @client.contact_phone %>
            <div><dt class="sr-only">Phone</dt><dd><%= phone_to @client.contact_phone, class: "hover:text-brand-600" %></dd></div>
          <% end %>
        </dl>
      <% else %>
        <p class="mt-3 text-sm text-gray-500">No contact person yet.</p>
      <% end %>
    </section>

    <% if @client.notes %>
      <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
        <h2 class="text-base font-semibold text-gray-900">Notes</h2>
        <p class="mt-3 whitespace-pre-line text-sm text-gray-700"><%= @client.notes %></p>
      </section>
    <% end %>
  </div>
</div>
