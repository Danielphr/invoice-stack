<% content_for :title, "Clients" %>

<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold text-gray-900">Clients</h1>
  <%= link_to "New client", new_client_path, class: "btn-primary" %>
</div>

<% if @clients.any? %>
  <div class="mt-8 overflow-x-auto rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left font-semibold text-gray-900">
        <tr>
          <th scope="col" class="px-4 py-3">Name</th>
          <th scope="col" class="px-4 py-3">Email</th>
          <th scope="col" class="px-4 py-3">Location</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 text-gray-600">
        <% @clients.each do |client| %>
          <tr>
            <td class="px-4 py-3 font-medium text-gray-900"><%= link_to client.name, client, class: "hover:text-indigo-600" %></td>
            <td class="px-4 py-3"><%= client.email %></td>
            <td class="px-4 py-3"><%= client.city %>, <%= client.country_name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="mt-8 rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
    <h2 class="text-sm font-semibold text-gray-900">No clients yet</h2>
    <p class="mt-1 text-sm text-gray-500">Add your first client to start sending invoices.</p>
    <%= link_to "New client", new_client_path, class: "btn-primary mt-6 inline-flex" %>
  </div>
<% end %>
