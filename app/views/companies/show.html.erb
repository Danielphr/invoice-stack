<% content_for :title, "Company" %>

<div data-controller="accent-color" data-accent-color-color-value="<%= @company.accent_color %>">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-4">
      <% if @company.logo.attached? %>
        <span class="flex h-28 w-52 shrink-0 items-center justify-center rounded-xl bg-white p-3 ring-1 ring-gray-900/5">
          <%= image_tag @company.logo.variant(:document), alt: "#{@company.name} logo", class: "max-h-full max-w-full object-contain" %>
        </span>
      <% else %>
        <span class="flex size-28 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-700" aria-hidden="true">
          <%= heroicon(:building, class: "size-14") %>
        </span>
      <% end %>
      <div class="min-w-0">
        <h1 class="text-2xl font-semibold text-gray-900"><%= @company.name %></h1>
        <ul role="list" class="mt-1 flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-500">
          <% if @company.email %>
            <li class="flex items-center gap-1.5"><%= heroicon(:envelope, class: "size-4") %><%= mail_to @company.email, class: "hover:text-brand-600" %></li>
          <% end %>
          <% if @company.city %>
            <li class="flex items-center gap-1.5"><%= heroicon(:map_pin, class: "size-4") %><%= [ @company.city, @company.country_name ].compact.join(", ") %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <%= link_to "Edit", edit_company_path, class: "btn-secondary" %>
  </div>

  <% unless @company.address_complete? %>
    <div role="note" class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-xl bg-amber-50 p-4 text-sm text-amber-800 ring-1 ring-amber-200">
      <p class="flex items-center gap-2"><%= heroicon(:warning, class: "size-5 shrink-0") %>Add your company's address so it appears on your invoices.</p>
      <%= link_to "Add address", edit_company_path, class: "font-semibold underline-offset-2 hover:underline" %>
    </div>
  <% end %>

  <div class="mt-10 space-y-10">
    <%= render layout: "shared/settings_section", locals: { title: "Profile", description: "How your company appears on invoices." } do %>
      <figure>
        <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 sm:p-8" aria-hidden="true">
          <div class="grid grid-cols-3 gap-4 text-xs text-gray-700">
            <div>
              <% if @company.logo.attached? %>
                <%= image_tag @company.logo.variant(:document), alt: "", class: "max-h-14 max-w-full object-contain" %>
              <% end %>
            </div>
            <div class="min-w-0 break-words">
              <p class="text-(--accent)"><%= @company.name %></p>
              <p><%= @company.email %></p>
            </div>
            <p class="min-w-0 break-words"><%= safe_join(@company.address_lines, tag.br) %></p>
          </div>
          <p class="mt-6 pl-1 text-sm font-bold text-(--accent)">INVOICE</p>
          <div class="mt-2 border-t border-gray-200"></div>
          <div class="mt-4 space-y-2">
            <div class="h-2 w-1/3 rounded-full bg-gray-100"></div>
            <div class="h-2 w-1/4 rounded-full bg-gray-100"></div>
          </div>
        </div>
        <figcaption class="mt-2 text-xs text-gray-500">Preview of the top of your invoices.</figcaption>
      </figure>

      <dl class="divide-y divide-gray-100 rounded-xl bg-white text-sm shadow-sm ring-1 ring-gray-900/5">
        <div class="flex items-center justify-between gap-4 px-5 py-3">
          <dt class="text-gray-500">Accent color</dt>
          <dd class="flex items-center gap-2 text-gray-900">
            <span class="size-4 rounded-full bg-(--accent) ring-1 ring-gray-900/10"></span>
            <code><%= @company.accent_color %></code>
          </dd>
        </div>
      </dl>
    <% end %>

    <%= render layout: "shared/settings_section", locals: { title: "Address", description: "Printed under your company name on invoices." } do %>
      <div class="rounded-xl bg-white px-5 py-4 text-sm shadow-sm ring-1 ring-gray-900/5">
        <% if @company.address_lines.any? %>
          <p class="text-gray-900"><%= safe_join(@company.address_lines, tag.br) %></p>
        <% else %>
          <p class="text-gray-500">No address yet.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
