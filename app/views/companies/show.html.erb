<% content_for :title, "Company" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div class="flex items-center gap-4">
    <% if @company.logo.attached? %>
      <%= image_tag @company.logo.variant(:document), alt: "#{@company.name} logo",
            class: "h-12 w-auto max-w-40 object-contain" %>
    <% end %>
    <h1 class="text-2xl font-semibold text-gray-900"><%= @company.name %></h1>
  </div>

  <%= link_to "Edit", edit_company_path, class: "btn-secondary" %>
</div>

<% unless @company.address_complete? %>
  <p role="note" class="mt-6 rounded-md bg-amber-50 p-4 text-sm text-amber-800">
    Add your company's address so it appears on your invoices.
  </p>
<% end %>

<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
  <section class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-base font-semibold text-gray-900">Details</h2>
    <dl class="mt-4 space-y-3 text-sm">
      <div>
        <dt class="text-gray-500">Email</dt>
        <dd class="text-gray-900"><%= @company.email ? mail_to(@company.email, class: "link") : "—" %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Time zone</dt>
        <dd class="text-gray-900"><%= @company.time_zone %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Default currency</dt>
        <dd class="text-gray-900"><%= @company.default_currency %> — <%= Currency.find(@company.default_currency)[:name] %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Accent color</dt>
        <dd class="flex items-center gap-2 text-gray-900">
          <%= tag.span class: "size-4 rounded-full ring-1 ring-gray-300", style: "background-color: #{@company.accent_color}" %>
          <code><%= @company.accent_color %></code>
        </dd>
      </div>
    </dl>
  </section>

  <section class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-base font-semibold text-gray-900">Address</h2>
    <p class="mt-4 text-sm text-gray-900">
      <%= @company.address_lines.any? ? safe_join(@company.address_lines, tag.br) : "—" %>
    </p>
  </section>

  <section class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-base font-semibold text-gray-900">Invoice numbers</h2>
    <dl class="mt-4 space-y-3 text-sm">
      <div>
        <dt class="text-gray-500">Pattern</dt>
        <dd class="text-gray-900"><code><%= @company.invoice_number_pattern %></code></dd>
      </div>
      <div>
        <dt class="text-gray-500">Next invoice</dt>
        <dd class="font-medium text-gray-900"><%= @next_invoice_number %></dd>
      </div>
    </dl>
  </section>
</div>
