<% content_for :title, "Edit company" %>

<%= link_to "← Company", company_path, class: "link text-sm" %>
<h1 class="mt-2 text-2xl font-semibold text-gray-900">Edit company</h1>

<%= form_with model: @company, url: company_path, method: :patch, class: "mt-8 max-w-5xl space-y-10" do |form| %>
  <%= render "shared/form_errors", model: @company %>

  <%= render layout: "settings_section", locals: { title: "Profile", description: "How your company appears on invoices." } do %>
    <div>
      <%= form.label :name, class: "label" do %>
        <%= Company.human_attribute_name(:name) %> <span class="text-red-500" aria-hidden="true">*</span>
      <% end %>
      <%= form.text_field :name, required: true, maxlength: 100, autocomplete: "organization", class: "input mt-2" %>
    </div>

    <div>
      <%= form.label :email, class: "label" %>
      <%= form.email_field :email, autocomplete: "email", class: "input mt-2" %>
    </div>

    <% saved_logo = @company.logo.attached? && @company.logo.blob.persisted? %>
    <div data-controller="dropzone">
      <span class="label">Logo</span>
      <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-stretch">
        <div class="relative flex h-24 w-full shrink-0 items-center justify-center rounded-md bg-gray-50 p-2 ring-1 ring-gray-200 sm:w-40">
          <%= tag.img src: (url_for(@company.logo.variant(:document)) if saved_logo), alt: "Logo preview", hidden: !saved_logo,
                class: "max-h-full max-w-full object-contain", data: { dropzone_target: "preview" } %>
          <%= tag.span "No logo", hidden: saved_logo, class: "text-xs text-gray-500", data: { dropzone_target: "placeholder" } %>

          <% if saved_logo %>
            <button type="submit" form="remove-logo" title="Remove logo"
                    class="absolute -top-2 -right-2 flex size-6 cursor-pointer items-center justify-center rounded-full bg-white text-gray-500 shadow-sm ring-1 ring-gray-300 hover:text-red-600">
              <span class="sr-only">Remove logo</span>
              <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          <% end %>
        </div>

        <label data-dropzone-target="zone"
               data-action="dragover->dropzone#highlight dragleave->dropzone#unhighlight drop->dropzone#drop"
               class="flex flex-1 cursor-pointer flex-col items-center justify-center gap-1 rounded-md border-2 border-dashed border-gray-300 px-4 py-5 text-center hover:border-indigo-400 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-600">
          <span class="text-sm text-gray-600"><span class="font-semibold text-indigo-600">Upload a file</span> or drag and drop</span>
          <span class="text-xs text-gray-500">PNG, JPG or WebP, up to 5 MB</span>
          <%= form.file_field :logo, accept: Company::LOGO_CONTENT_TYPES.join(","), class: "sr-only",
                data: { dropzone_target: "input", action: "dropzone#preview" } %>
        </label>
      </div>
    </div>

    <div>
      <%= form.label :accent_color, class: "label" %>
      <div class="mt-2 flex items-center gap-3">
        <%= form.color_field :accent_color, class: "h-10 w-16 cursor-pointer rounded-md border-0 bg-white p-1 ring-1 ring-gray-300" %>
        <span class="text-sm text-gray-500">Used for headings on your invoices.</span>
      </div>
    </div>
  <% end %>

  <%= render layout: "settings_section", locals: { title: "Address", description: "Printed under your company name on invoices." } do %>
    <div>
      <%= form.label :address_line1, class: "label" %>
      <%= form.text_field :address_line1, autocomplete: "address-line1", class: "input mt-2" %>
    </div>

    <div>
      <%= form.label :address_line2, class: "label" %>
      <%= form.text_field :address_line2, autocomplete: "address-line2", class: "input mt-2" %>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <%= form.label :city, class: "label" %>
        <%= form.text_field :city, autocomplete: "address-level2", class: "input mt-2" %>
      </div>

      <div>
        <%= form.label :state, class: "label" %>
        <%= form.text_field :state, autocomplete: "address-level1", class: "input mt-2" %>
      </div>

      <div>
        <%= form.label :postal_code, class: "label" %>
        <%= form.text_field :postal_code, autocomplete: "postal-code", class: "input mt-2" %>
      </div>

      <div>
        <%= form.label :country, class: "label" %>
        <%= form.select :country, Country::NAMES.invert, { include_blank: "Select a country" }, class: "input mt-2" %>
      </div>
    </div>
  <% end %>

  <%= render layout: "settings_section", locals: { title: "Preferences", description: "Defaults used across the app." } do %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <%= form.label :time_zone, class: "label" %>
        <%= form.time_zone_select :time_zone, nil, {}, class: "input mt-2" %>
        <p class="mt-2 text-xs text-gray-500">Used for invoice dates and when invoices become overdue.</p>
      </div>

      <div>
        <%= form.label :default_currency, class: "label" %>
        <%= form.select :default_currency, Currency::ALL.map { |code, details| [ "#{code} — #{details[:name]}", code ] }, {},
              class: "input mt-2" %>
        <p class="mt-2 text-xs text-gray-500">Preselected on new invoices.</p>
      </div>
    </div>
  <% end %>

  <%= render layout: "settings_section", locals: { title: "Invoice numbers", description: "How new invoices are numbered." } do %>
    <div>
      <%= form.label :invoice_number_pattern, class: "label" do %>
        <%= Company.human_attribute_name(:invoice_number_pattern) %> <span class="text-red-500" aria-hidden="true">*</span>
      <% end %>
      <%= form.text_field :invoice_number_pattern, required: true, maxlength: 30, class: "input mt-2" %>
      <p class="mt-2 text-xs text-gray-500">
        Use <code>{NUMBER}</code> exactly once. You can also add <code>{YEAR}</code> and <code>{MONTH}</code>,
        taken from each invoice's issue date. Example: <code>INV-{YEAR}-{NUMBER}</code>.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <%= form.label :invoice_number_digits, class: "label" do %>
          <%= Company.human_attribute_name(:invoice_number_digits) %> <span class="text-red-500" aria-hidden="true">*</span>
        <% end %>
        <%= form.number_field :invoice_number_digits, required: true, min: 1, max: 10, class: "input mt-2" %>
        <p class="mt-2 text-xs text-gray-500">Pads with zeros, e.g. 4 digits gives 0042.</p>
      </div>

      <div>
        <%= form.label :next_invoice_number, class: "label" do %>
          <%= Company.human_attribute_name(:next_invoice_number) %> <span class="text-red-500" aria-hidden="true">*</span>
        <% end %>
        <% lowest = @company.lowest_next_invoice_number %>
        <%= form.number_field :next_invoice_number, required: true, min: lowest, max: 999_999_999, class: "input mt-2" %>
        <% if lowest > 1 %>
          <p class="mt-2 text-xs text-gray-500">Numbers below <%= lowest %> are already used.</p>
        <% end %>
      </div>
    </div>

    <% if @next_invoice_number %>
      <p class="rounded-md bg-gray-50 p-4 text-sm text-gray-700">
        Next invoice will be <strong class="font-semibold text-gray-900"><%= @next_invoice_number %></strong>
      </p>
    <% end %>
  <% end %>

  <div class="flex justify-end gap-3 border-t border-gray-200 pt-6">
    <%= link_to "Cancel", company_path, class: "btn-secondary" %>
    <%= form.submit "Save", class: "btn-primary" %>
  </div>
<% end %>

<% if @company.logo.attached? %>
  <%= button_to "Remove logo", company_logo_path, method: :delete,
        form: { id: "remove-logo", hidden: true, data: { turbo_confirm: "Remove your company logo?" } } %>
<% end %>
