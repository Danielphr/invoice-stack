<!DOCTYPE html>
<html lang="en" class="h-full bg-white">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="h-full">
    <main class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
      <div class="sm:mx-auto sm:w-full sm:max-w-sm">
        <p class="text-center text-xl font-bold tracking-tight text-brand-600">InvoiceStack</p>

        <% if content_for?(:title) %>
          <h1 class="mt-10 text-center text-2xl/9 font-bold tracking-tight text-gray-900"><%= yield :title %></h1>
        <% end %>
      </div>

      <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
        <%= render "layouts/flash" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
