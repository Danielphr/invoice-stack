<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="h-full" data-controller="sidebar" data-action="keydown.esc@window->sidebar#close">
    <%= render "layouts/sidebar" %>
    <%= render "layouts/confirm_dialog" %>

    <div class="lg:pl-72">
      <header class="sticky top-0 z-30 flex items-center gap-x-4 bg-navy-950 px-4 py-3 lg:hidden">
        <button type="button" class="-m-2.5 p-2.5 text-navy-300 hover:text-white"
                aria-controls="sidebar" aria-expanded="false"
                data-sidebar-target="toggle" data-action="sidebar#open">
          <span class="sr-only">Open menu</span>
          <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
        <%= image_tag "logo-light.svg", alt: "InvoiceStack", class: "h-7 w-auto" %>
      </header>

      <main class="px-4 py-10 sm:px-6 lg:px-8">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
