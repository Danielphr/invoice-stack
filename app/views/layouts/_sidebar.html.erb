<div class="fixed inset-0 z-40 hidden bg-navy-950/80 lg:hidden"
     data-sidebar-target="backdrop" data-action="click->sidebar#close"></div>

<aside id="sidebar" data-sidebar-target="panel"
       class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col bg-navy-950 px-6 transition-transform max-lg:invisible lg:translate-x-0">
  <div class="flex h-20 shrink-0 items-center justify-between">
    <%= link_to root_path do %>
      <%= image_tag "logo-light.svg", alt: "InvoiceStack", class: "h-10 w-auto" %>
    <% end %>

    <button type="button" class="-m-2.5 p-2.5 text-navy-300 hover:text-white lg:hidden" data-action="sidebar#close">
      <span class="sr-only">Close menu</span>
      <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav aria-label="Main" class="flex-1">
    <ul role="list" class="-mx-2 space-y-1">
      <li><%= nav_link_to "Dashboard", root_path, icon: :home %></li>
      <li><%= nav_link_to "Company", company_path, icon: :building %></li>
      <li><%= nav_link_to "Clients", clients_path, icon: :users %></li>
      <li><%= nav_link_to "Invoices", invoices_path, icon: :banknotes %></li>
    </ul>
  </nav>

  <nav aria-label="Secondary" class="pb-4">
    <ul role="list" class="-mx-2 space-y-1">
      <li><%= nav_link_to "Settings", settings_path, icon: :cog %></li>
    </ul>
  </nav>

  <div class="-mx-6 border-t border-navy-800 px-4 py-4">
    <% on_account = current_page?(account_path) %>
    <%= link_to account_path, aria: { current: ("page" if on_account) },
          class: class_names("flex items-center gap-x-3 rounded-md px-2 py-2", on_account ? "bg-navy-800" : "hover:bg-navy-800") do %>
      <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-500 text-xs font-semibold text-white" aria-hidden="true">
        <%= Current.user.initials %>
      </span>
      <span class="min-w-0">
        <span class="sr-only">Your account:</span>
        <span class="block truncate text-sm font-semibold text-white"><%= Current.user.full_name %></span>
        <span class="block truncate text-xs text-navy-300"><%= Current.user.company.name %></span>
      </span>
    <% end %>

    <%= button_to "Log out", session_path, method: :delete,
          class: "mt-2 px-2 text-sm font-semibold text-navy-300 hover:text-white" %>
  </div>
</aside>
