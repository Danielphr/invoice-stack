<% content_for :title, "Create your account" %>

<%= form_with model: @user, url: registration_path, class: "space-y-6" do |form| %>
  <%= render "shared/form_errors", model: @user %>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :first_name, class: "label" %>
      <%= form.text_field :first_name, required: true, autofocus: true, autocomplete: "given-name", class: "input mt-2" %>
    </div>

    <div>
      <%= form.label :last_name, class: "label" %>
      <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "input mt-2" %>
    </div>
  </div>

  <div>
    <%= form.label :email_address, class: "label" %>
    <%= form.email_field :email_address, required: true, autocomplete: "email", class: "input mt-2" %>
  </div>

  <div>
    <%= form.label :password, class: "label" %>
    <%= render "shared/password_field", form: form, field: :password, autocomplete: "new-password",
          minlength: User::PASSWORD_MIN_LENGTH, aria: { describedby: "password-hint" } %>
    <p id="password-hint" class="mt-2 text-xs text-gray-500">At least <%= User::PASSWORD_MIN_LENGTH %> characters.</p>
  </div>

  <div>
    <%= form.label :password_confirmation, class: "label" %>
    <%= render "shared/password_field", form: form, field: :password_confirmation, autocomplete: "new-password" %>
  </div>

  <%= form.submit "Create account", class: "btn-primary w-full" %>
<% end %>

<p class="mt-10 text-center text-sm text-gray-500">
  Already have an account? <%= link_to "Sign in", new_session_path, class: "link" %>
</p>
