<% content_for :title, "Sign in to your account" %>

<%= form_with url: session_path, class: "space-y-6" do |form| %>
  <div>
    <%= form.label :email_address, class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], class: "input mt-2" %>
  </div>

  <div>
    <div class="flex items-center justify-between">
      <%= form.label :password, class: "label" %>
      <%= link_to "Forgot password?", new_password_path, class: "link text-sm" %>
    </div>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
          class: "input mt-2" %>
  </div>

  <%= form.submit "Sign in", class: "btn-primary w-full" %>
<% end %>

<p class="mt-10 text-center text-sm text-gray-500">
  Don't have an account? <%= link_to "Sign up", new_registration_path, class: "link" %>
</p>
