<% content_for :title, invoice_title(@invoice) %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <%= link_to "← Invoices", @invoice.archived? ? invoices_path(show: "archived") : invoices_path, class: "link text-sm" %>
    <div class="mt-2 flex items-center gap-3">
      <h1 class="text-2xl font-semibold text-gray-900"><%= invoice_title(@invoice) %></h1>
      <%= invoice_status_badge(@invoice) %>
      <% if @invoice.archived? %>
        <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">Archived</span>
      <% end %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <% if @invoice.archived? %>
      <%= button_to "Unarchive", invoice_archive_path(@invoice), method: :delete, class: "btn-primary" %>
    <% else %>
      <%= render "status_actions", invoice: @invoice %>
    <% end %>
    <%= link_to "PDF", invoice_path(@invoice, format: :pdf), target: "_blank", rel: "noopener", class: "btn-secondary",
          data: { turbo: false } %>
    <% unless @invoice.archived? %>
      <%= link_to "Edit", edit_invoice_path(@invoice), class: "btn-secondary" %>
      <% if @invoice.archivable? %>
        <%= button_to "Archive", invoice_archive_path(@invoice), class: "btn-secondary" %>
      <% end %>
    <% end %>
    <% if @invoice.draft? %>
      <%= button_to "Delete", @invoice, method: :delete, class: "btn-danger",
            form: { data: { turbo_confirm: "Delete this draft? This cannot be undone.", confirm_title: "Delete draft",
              confirm_button: "Delete", confirm_destructive: true } } %>
    <% end %>
  </div>
</div>

<% unless @invoice.company.address_complete? %>
  <p role="note" class="mt-6 rounded-md bg-amber-50 p-4 text-sm text-amber-800">
    Your company's address isn't on this invoice yet. <%= link_to "Add it on the Company page", company_path, class: "font-semibold underline" %>.
  </p>
<% end %>

<section class="mt-8 rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
  <dl class="grid grid-cols-2 gap-6 text-sm sm:grid-cols-4">
    <div>
      <dt class="text-gray-500">Client</dt>
      <dd class="mt-1 font-medium text-gray-900"><%= link_to @invoice.client.name, @invoice.client, class: "link" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Issued</dt>
      <dd class="mt-1 text-gray-900"><%= l(@invoice.issue_date, format: :medium) %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Due</dt>
      <dd class="mt-1 text-gray-900"><%= @invoice.due_date ? l(@invoice.due_date, format: :medium) : "—" %></dd>
    </div>
    <% if @invoice.paid? %>
      <div>
        <dt class="text-gray-500">Paid</dt>
        <dd class="mt-1 text-gray-900"><%= l(@invoice.paid_on, format: :medium) %></dd>
      </div>
    <% end %>
    <div>
      <dt class="text-gray-500">Currency</dt>
      <dd class="mt-1 text-gray-900"><%= @invoice.currency %></dd>
    </div>
  </dl>

  <div class="mt-8 overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="text-left font-semibold text-gray-900">
        <tr>
          <th scope="col" class="py-3 pr-4">Description</th>
          <th scope="col" class="px-4 py-3 text-right"><%= quantity_label(@invoice) %></th>
          <th scope="col" class="px-4 py-3 text-right"><%= unit_price_label(@invoice) %></th>
          <th scope="col" class="py-3 pl-4 text-right">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 text-gray-600">
        <% @invoice.items.each do |item| %>
          <tr>
            <td class="py-3 pr-4 text-gray-900"><%= item.description %></td>
            <td class="px-4 py-3 text-right"><%= number_with_precision(item.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap"><%= format_money(item.unit_price, @invoice.currency) %></td>
            <td class="py-3 pl-4 text-right whitespace-nowrap text-gray-900"><%= format_money(item.amount, @invoice.currency) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <dl class="mt-6 ml-auto max-w-xs space-y-2 text-sm">
    <div class="flex justify-between">
      <dt class="text-gray-500">Subtotal</dt>
      <dd class="text-gray-900"><%= format_money(@invoice.subtotal, @invoice.currency) %></dd>
    </div>
    <% if @invoice.discount.positive? %>
      <div class="flex justify-between">
        <dt class="text-gray-500">Discount</dt>
        <dd class="text-gray-900">−<%= format_money(@invoice.discount, @invoice.currency) %></dd>
      </div>
    <% end %>
    <div class="flex justify-between border-t border-gray-200 pt-2 font-semibold">
      <dt class="text-gray-900">Total</dt>
      <dd class="text-gray-900"><%= format_money(@invoice.total, @invoice.currency) %></dd>
    </div>
  </dl>
</section>

<% if @invoice.notes %>
  <section class="mt-6 rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
    <h2 class="text-base font-semibold text-gray-900">Notes</h2>
    <p class="mt-4 whitespace-pre-line text-sm text-gray-900"><%= @invoice.notes %></p>
  </section>
<% end %>
