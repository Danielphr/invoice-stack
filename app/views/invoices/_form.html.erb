<%= form_with model: invoice, class: "mt-8 space-y-10",
      data: { controller: "invoice-form", invoice_form_labels_value: InvoicesHelper::ITEM_LABELS.to_json } do |form| %>
  <%= render "shared/form_errors", model: invoice %>

  <%= render layout: "shared/settings_section", locals: { title: "Details", description: "Who you're billing and when payment is due." } do %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="sm:col-span-2">
        <%= form.label :client_id, "Client", class: "label" %>
        <%= form.collection_select :client_id, clients, :id, :name, { prompt: "Select a client" }, required: true, class: "input mt-2" %>
      </div>

      <div>
        <%= form.label :number, class: "label" %>
        <%= form.text_field :number, disabled: true, placeholder: (invoice_number_preview(invoice) unless invoice.number),
              class: "input mt-2 disabled:bg-gray-50 disabled:text-gray-500" %>
        <% unless invoice.number %>
          <p class="mt-2 text-xs text-gray-500">Assigned when the invoice is sent.</p>
        <% end %>
      </div>

      <div>
        <%= form.label :issue_date, class: "label" %>
        <%= form.date_field :issue_date, required: true, class: "input mt-2" %>
      </div>

      <div>
        <%= form.label :due_date, class: "label" %>
        <%= form.date_field :due_date, class: "input mt-2" %>
      </div>

      <div>
        <%= form.label :status, class: "label" %>
        <%= form.select :status, invoice_status_options(invoice), {}, class: "input mt-2" %>
        <% unless invoice.sequence_in_database %>
          <p class="mt-2 text-xs text-gray-500">Changing the status from Draft assigns the invoice number.</p>
        <% end %>
      </div>

      <% if invoice.paid? %>
        <div>
          <%= form.label :paid_on, class: "label" %>
          <%= form.date_field :paid_on, class: "input mt-2" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render layout: "shared/settings_section", locals: { title: "Items", description: "What you're billing for, and how it's charged." } do %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <%= form.label :billing_type, class: "label" %>
        <%= form.select :billing_type, Invoice.billing_types.keys.map { [ it.humanize, it ] }, {},
              data: { action: "invoice-form#updateLabels" }, class: "input mt-2" %>
      </div>

      <div>
        <%= form.label :currency, class: "label" %>
        <%= form.select :currency, Currency::ALL.map { |code, details| [ "#{code} — #{details[:name]}", code ] }, {},
              data: { invoice_form_target: "currency", action: "invoice-form#recalculate" }, class: "input mt-2" %>
      </div>
    </div>

    <div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="text-left font-medium text-gray-900">
            <tr>
              <th scope="col" id="item-description-header" class="pb-2 pr-2">Description</th>
              <th scope="col" id="item-quantity-header" class="px-2 pb-2" data-invoice-form-target="quantityLabel"><%= quantity_label(invoice) %></th>
              <th scope="col" id="item-unit-price-header" class="px-2 pb-2" data-invoice-form-target="unitPriceLabel"><%= unit_price_label(invoice) %></th>
              <th scope="col" class="px-2 pb-2 text-right">Amount</th>
              <th scope="col" class="pb-2 pl-2"><span class="sr-only">Remove</span></th>
            </tr>
          </thead>
          <tbody data-invoice-form-target="items">
            <%= form.fields_for :items, include_id: false do |item_form| %>
              <%= render "item_fields", form: item_form %>
            <% end %>
          </tbody>
        </table>
      </div>

      <template data-invoice-form-target="template">
        <%= form.fields_for :items, InvoiceItem.new, child_index: "NEW_ITEM", include_id: false do |item_form| %>
          <%= render "item_fields", form: item_form %>
        <% end %>
      </template>

      <button type="button" class="link mt-4 cursor-pointer text-sm" data-action="invoice-form#addItem">+ Add item</button>
    </div>
  <% end %>

  <%= render layout: "shared/settings_section", locals: { title: "Total", description: "A discount is taken off the subtotal." } do %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div>
        <%= form.label :discount, class: "label" %>
        <%= form.number_field :discount, min: 0, step: 0.01,
              data: { invoice_form_target: "discount", action: "invoice-form#recalculate" }, class: "input mt-2" %>
      </div>

      <dl class="space-y-2 self-end text-sm">
        <div class="flex justify-between">
          <dt class="text-gray-500">Subtotal</dt>
          <dd class="tabular-nums text-gray-900" data-invoice-form-target="subtotal"></dd>
        </div>
        <div class="flex justify-between border-t border-gray-200 pt-2 font-semibold">
          <dt class="text-gray-900">Total</dt>
          <dd class="tabular-nums text-gray-900" data-invoice-form-target="total"></dd>
        </div>
      </dl>
    </div>
  <% end %>

  <%= render layout: "shared/settings_section", locals: { title: "Notes", description: "Printed at the bottom of the invoice." } do %>
    <div>
      <%= form.label :notes, class: "sr-only" %>
      <%= form.text_area :notes, rows: 4, maxlength: 500, class: "input" %>
    </div>
  <% end %>

  <div class="flex justify-end gap-3 border-t border-gray-200 pt-6">
    <%= link_to "Cancel", invoice.persisted? ? invoice : invoices_path, class: "btn-secondary" %>
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
