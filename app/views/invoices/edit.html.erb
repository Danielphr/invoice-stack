<% content_for :title, "Edit #{invoice_title(@invoice).downcase_first}" %>

<%= link_to "← #{invoice_title(@invoice)}", @invoice, class: "link text-sm" %>
<h1 class="mt-2 text-2xl font-semibold text-gray-900">Edit invoice</h1>

<% if (warning = issued_invoice_warning(@invoice)) %>
  <p role="note" class="mt-6 rounded-md bg-amber-50 p-4 text-sm text-amber-800"><%= warning %></p>
<% end %>

<%= render "form", invoice: @invoice, clients: @clients %>
