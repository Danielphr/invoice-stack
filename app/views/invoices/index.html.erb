<% content_for :title, "Invoices" %>

<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold text-gray-900">Invoices</h1>
  <%= link_to "New invoice", new_invoice_path, class: "btn-primary" %>
</div>

<% if @invoices.any? %>
  <div class="mt-8 overflow-x-auto rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left font-semibold text-gray-900">
        <tr>
          <%= invoice_sort_header "Number", "number" %>
          <%= invoice_sort_header "Client", "client" %>
          <%= invoice_sort_header "Issued", "issued" %>
          <%= invoice_sort_header "Due", "due" %>
          <%= invoice_sort_header "Billing", "billing" %>
          <%= invoice_sort_header "Status", "status" %>
          <%= invoice_sort_header "Total", "total", align: :right %>
          <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 text-gray-600">
        <% @invoices.each do |invoice| %>
          <% label = invoice.number || "draft for #{invoice.client.name}" %>
          <tr>
            <td class="px-4 py-3 font-medium text-gray-900">
              <%= link_to invoice.number || "Draft", invoice, class: [ "hover:text-indigo-600", ("font-normal text-gray-400" unless invoice.number) ] %>
            </td>
            <td class="px-4 py-3"><%= invoice.client.name %></td>
            <td class="px-4 py-3 whitespace-nowrap"><%= l(invoice.issue_date, format: :medium) %></td>
            <td class="px-4 py-3 whitespace-nowrap"><%= invoice.due_date ? l(invoice.due_date, format: :medium) : "—" %></td>
            <td class="px-4 py-3"><%= invoice.billing_type.humanize %></td>
            <td class="px-4 py-3"><%= invoice_status_badge(invoice) %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap text-gray-900"><%= format_money(invoice.total, invoice.currency) %></td>
            <td class="px-4 py-3">
              <div class="flex justify-end gap-4 whitespace-nowrap">
                <%= link_to invoice_path(invoice, format: :pdf), target: "_blank", rel: "noopener", class: "link", data: { turbo: false } do %>
                  PDF<span class="sr-only">, <%= label %></span>
                <% end %>
                <%= link_to edit_invoice_path(invoice), class: "link" do %>
                  Edit<span class="sr-only">, <%= label %></span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pagy.last > 1 %>
    <div class="mt-6 flex justify-center"><%== @pagy.series_nav %></div>
  <% end %>
<% else %>
  <div class="mt-8 rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
    <h2 class="text-sm font-semibold text-gray-900">No invoices yet</h2>
    <p class="mt-1 text-sm text-gray-500">Create your first invoice to bill a client.</p>
    <%= link_to "New invoice", new_invoice_path, class: "btn-primary mt-6 inline-flex" %>
  </div>
<% end %>
