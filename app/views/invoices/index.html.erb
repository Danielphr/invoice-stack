<% content_for :title, "Invoices" %>

<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold text-gray-900">Invoices</h1>
  <%= link_to "New invoice", new_invoice_path, class: "btn-primary" %>
</div>

<% if @any_archived %>
  <nav aria-label="Invoices" class="mt-6 inline-flex gap-1 rounded-lg bg-white p-1 text-sm font-medium shadow-sm ring-1 ring-gray-900/5">
    <%= filter_link "Active", invoices_path, current: !@archived %>
    <%= filter_link "Archived", invoices_path(show: "archived"), current: @archived %>
  </nav>
<% end %>

<% if @invoices.any? %>
  <% filters = @archived ? { show: "archived" } : {} %>
  <% company = Current.user.company %>
  <div class="mt-6 overflow-x-auto rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left font-semibold text-gray-900">
        <tr>
          <%= sort_header "Number", "number", filters: %>
          <%= sort_header "Client", "client", filters: %>
          <%= sort_header "Issued", "issued", filters: %>
          <%= sort_header "Due", "due", filters: %>
          <%= sort_header "Billing", "billing", filters: %>
          <%= sort_header "Status", "status", filters: %>
          <% if company.tax_documents_enabled? %>
            <th scope="col" class="px-4 py-3"><%= company.tax_document_label %></th>
          <% end %>
          <%= sort_header "Total", "total", align: :right, filters: %>
          <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 text-gray-600">
        <% @invoices.each do |invoice| %>
          <% label = invoice.number || "draft for #{invoice.client.name}" %>
          <tr>
            <td class="px-4 py-3 font-medium text-gray-900">
              <%= link_to invoice.number || "Draft", invoice, class: [ "hover:text-brand-600", ("font-normal text-gray-400" unless invoice.number) ] %>
            </td>
            <td class="px-4 py-3"><%= invoice.client.name %></td>
            <td class="px-4 py-3 whitespace-nowrap"><%= l(invoice.issue_date, format: :medium) %></td>
            <td class="px-4 py-3 whitespace-nowrap"><%= invoice.due_date ? l(invoice.due_date, format: :medium) : "—" %></td>
            <td class="px-4 py-3"><%= invoice.billing_type.humanize %></td>
            <td class="px-4 py-3"><%= invoice_status_badge(invoice) %></td>
            <% if company.tax_documents_enabled? %>
              <td class="px-4 py-3 whitespace-nowrap">
                <%= render "invoices/tax_document_cell", invoice: %>
              </td>
            <% end %>
            <td class="px-4 py-3 text-right whitespace-nowrap text-gray-900"><%= format_money(invoice.total, invoice.currency) %></td>
            <td class="px-4 py-3">
              <div class="flex justify-end gap-4 whitespace-nowrap">
                <%= link_to invoice_path(invoice, format: :pdf), target: "_blank", rel: "noopener", class: "link", data: { turbo: false } do %>
                  PDF<span class="sr-only">, <%= label %></span>
                <% end %>
                <% unless invoice.archived? %>
                  <%= link_to edit_invoice_path(invoice), class: "link" do %>
                    Edit<span class="sr-only">, <%= label %></span>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pagy.last > 1 %>
    <div class="mt-6 flex justify-center"><%== @pagy.series_nav %></div>
  <% end %>
<% elsif @archived %>
  <div class="mt-6 rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
    <h2 class="text-sm font-semibold text-gray-900">No archived invoices</h2>
    <p class="mt-1 text-sm text-gray-500">Paid and cancelled invoices you archive are kept here, out of your way.</p>
  </div>
<% else %>
  <div class="mt-8 rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
    <h2 class="text-sm font-semibold text-gray-900">No invoices yet</h2>
    <p class="mt-1 text-sm text-gray-500">Create your first invoice to bill a client.</p>
    <%= link_to "New invoice", new_invoice_path, class: "btn-primary mt-6 inline-flex" %>
  </div>
<% end %>
