<% content_for :title, "New invoice" %>

<%= link_to "← Invoices", invoices_path, class: "link text-sm" %>
<h1 class="mt-2 text-2xl font-semibold text-gray-900">New invoice</h1>

<% if @clients.any? %>
  <%= render "form", invoice: @invoice, clients: @clients %>
<% else %>
  <div class="mt-8 rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
    <h2 class="text-sm font-semibold text-gray-900">Add a client first</h2>
    <p class="mt-1 text-sm text-gray-500">Every invoice is billed to one of your clients.</p>
    <%= link_to "New client", new_client_path, class: "btn-primary mt-6 inline-flex" %>
  </div>
<% end %>
