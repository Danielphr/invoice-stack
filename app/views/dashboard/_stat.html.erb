<%# locals: (label:, totals:, count:, empty:, alert: false) %>
<div class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-gray-900/5">
  <dt class="text-sm font-medium text-gray-500"><%= label %></dt>
  <dd class="mt-2">
    <% if totals.any? %>
      <% totals.each do |currency, amount| %>
        <p class="font-display text-2xl font-semibold tracking-tight <%= alert ? "text-red-700" : "text-gray-900" %>"><%= format_money(amount, currency) %></p>
      <% end %>
    <% else %>
      <p class="font-display text-2xl font-semibold tracking-tight text-gray-400"><%= empty %></p>
    <% end %>
    <p class="mt-1 text-sm text-gray-500"><%= pluralize(count, "invoice") %></p>
  </dd>
</div>
