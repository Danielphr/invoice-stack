<%# locals: (overdue:, due_soon:, currency:) %>
<section aria-labelledby="attention-heading" class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
  <h2 id="attention-heading" class="text-lg font-semibold text-gray-900">Needs attention</h2>
  <p class="mt-1 text-sm text-gray-500">Overdue invoices and invoices due in the next <%= Dashboard::DUE_SOON_DAYS %> days.</p>

  <% if overdue.empty? && due_soon.empty? %>
    <p class="mt-6 text-sm text-gray-500">Nothing needs attention. All sent invoices are on time.</p>
  <% else %>
    <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-2">
      <% [ [ "Overdue", overdue ], [ "Due soon", due_soon ] ].each do |title, invoices| %>
        <div>
          <h3 class="text-sm font-semibold text-gray-900"><%= title %> <span class="font-normal text-gray-500">· <%= invoices.size %></span></h3>

          <% if invoices.empty? %>
            <p class="mt-3 text-sm text-gray-500">None.</p>
          <% else %>
            <ul role="list" class="mt-3 divide-y divide-gray-100">
              <% invoices.first(5).each do |invoice| %>
                <li class="flex items-center justify-between gap-4 py-3 text-sm">
                  <div class="min-w-0">
                    <%= link_to invoice.number, invoice, class: "font-medium text-gray-900 hover:text-brand-600" %>
                    <p class="truncate text-gray-500"><%= invoice.client.name %></p>
                  </div>
                  <div class="flex shrink-0 flex-col items-end gap-1">
                    <span class="font-medium tabular-nums text-gray-900"><%= format_money(invoice.total, currency) %></span>
                    <%= due_badge(invoice) %>
                  </div>
                </li>
              <% end %>
            </ul>

            <% if invoices.size > 5 %>
              <%= link_to "+#{invoices.size - 5} more", invoices_path(sort: "due", direction: "asc"), class: "link mt-2 inline-block text-sm" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
